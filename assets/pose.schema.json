{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:story-orchestrator:pose:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label",
    "tags",
    "framing",
    "props",
    "text",
    "keypoints",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 480
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 480
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "standing",
          "sitting",
          "kneeling",
          "moving",
          "fighting",
          "casting",
          "gesture",
          "lying"
        ]
      }
    },
    "framing": {
      "enum": [
        "full",
        "thigh",
        "close"
      ]
    },
    "props": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keywords"
      ],
      "properties": {
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "keypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "canvas",
        "points"
      ],
      "properties": {
        "format": {
          "const": "openpose-body18"
        },
        "canvas": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 32,
            "maximum": 8192
          }
        },
        "points": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "items": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              }
            ]
          }
        }
      }
    }
  }
}
