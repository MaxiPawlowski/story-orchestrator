{
  "compilerOptions": {
    "target": "ES2020",
    // Explicit, because `types: []` below removes the automatic @types inclusion that silently
    // widened the lib set (an @types package referencing a newer lib was doing it). The code uses
    // `.at()` and iterates NodeLists, so the lib has to say so itself.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "./src",
    "resolveJsonModule": true,
    // No automatic @types inclusion: TypeScript otherwise pulls in every package it
    // finds in a node_modules/@types above this one, with no include entry and no way to see it in
    // the project file. A host with @types/toastr installed merged its `Window.toastr` into ours and
    // broke two assignments in stHost/slashCommands.ts (measured: .debug/toastr-repro.mjs). Our own
    // global.d.ts declares everything we rely on, so nothing is lost by owning the list explicitly.
    "types": [],
    "allowJs": true,
    "paths": {
      "@components/*": ["components/*"],
      "@services/*": ["services/*"],
      "@utils/*": ["utils/*"],
      "@constants/*": ["constants/*"],
      "@engine/*": ["engine/*"],
      "@runtime/*": ["runtime/*"],
      "@extraction/*": ["extraction/*"],
      "@pacing/*": ["pacing/*"],
      "@generation/*": ["generation/*"],
      "@memory/*": ["memory/*"],
      "@copilot/*": ["copilot/*"],
      "@talk/*": ["talk/*"],
      "@wizard/*": ["wizard/*"],
      "@stagecraft/*": ["stagecraft/*"],
      "@judge/*": ["judge/*"],
      "@features/*": ["features/*"]
    }
  },
  "include": ["src/index.tsx", "src/engine/**/*.ts", "src/extraction/**/*.ts", "src/runtime/**/*.ts", "src/pacing/**/*.ts", "src/generation/**/*.ts", "src/services/**/*.ts", "src/utils/**/*.ts", "src/constants/**/*.ts", "src/memory/**/*.ts", "src/studio/**/*.ts", "src/studio/**/*.tsx", "src/copilot/**/*.ts", "src/talk/**/*.ts", "src/wizard/**/*.ts", "src/stagecraft/**/*.ts", "src/judge/**/*.ts", "src/features/**/*.ts", "src/features/**/*.tsx", "src/components/**/*.ts", "src/components/**/*.tsx", "src/sprites/**/*.ts", "src/sprites/**/*.tsx", "global.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
