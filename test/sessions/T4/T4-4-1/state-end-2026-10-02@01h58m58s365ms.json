        "boundary": 7,
        "pass": "epistemic:knows",
        "validity": "live"
      },
      "subject": "Belle",
      "tag": "knows",
      "content": "The overturned cart's cargo was left untouched and the wheel was clean-snapped, not shattered.",
      "createdAt": 7,
      "messageId": 23
    },
    {
      "id": "09b4fad4-6b13-4fba-8882-ea8d8e74f52e",
      "provenance": {
        "source": "extractor",
        "messageId": 23,
        "boundary": 7,
        "pass": "epistemic:suspects",
        "validity": "live"
      },
      "subject": "Belle",
      "tag": "suspects",
      "content": "Something drove the cart's owners off fast enough that they abandoned their goods.",
      "createdAt": 7,
      "messageId": 23
    },
    {
      "id": "96145f69-5818-4544-8e35-8f1ad4ee5457",
      "provenance": {
