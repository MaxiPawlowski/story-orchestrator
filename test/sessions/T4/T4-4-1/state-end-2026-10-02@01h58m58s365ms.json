        "boundary": 7,
        "pass": "epistemic:intends",
        "validity": "live"
      },
      "subject": "Belle",
      "tag": "intends",
      "content": "To decide with Max whether to camp at the cart or push on toward Wendhope.",
      "createdAt": 7,
      "messageId": 23
    },
    {
      "id": "f42ef3e4-db4c-4674-83d6-4049527be278",
      "provenance": {
