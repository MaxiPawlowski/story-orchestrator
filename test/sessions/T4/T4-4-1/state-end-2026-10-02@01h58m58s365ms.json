      },
      "subject": "Dalan",
      "tag": "knows",
      "content": "The riderless Sheridan horse has walked for hours or days without tiring.",
      "createdAt": 7,
      "messageId": 23
    },
    {
      "id": "7de778e8-aece-4caa-957e-4c3a226a5380",
      "provenance": {
        "source": "extractor",
        "messageId": 23,
        "boundary": 7,
        "pass": "epistemic:knows",
        "validity": "live"
      },
      "subject": "Dalan",
      "tag": "knows",
      "content": "The cart's tracks show no struggle, no boot prints, no blood.",
      "createdAt": 7,
      "messageId": 23
    },
    {
      "id": "6b5568c1-8c3d-493b-bedd-e4f40e8bc8c7",
      "provenance": {
