{
  "id": "delayed-echoes-lab",
  "title": "Delayed echoes lab",
  "description": "Synthetic story for v2.9 plan 07: echoes after a transition, a quest ending, a milestone and a check result, for a member and for the narrator.",
  "roster": [
    { "id": "mara", "name": "Mara Voss", "role": "a trader" },
    { "id": "tom", "name": "Tom", "role": "a ferryman" },
    { "id": "narrator", "name": "DM Narrator", "role": "narrator", "view": "omniscient" }
  ],
  "clock": { "times": ["morning", "afternoon", "evening", "night"] },
  "qualities": [
    { "key": "left_market", "type": "bool", "source": "extractor", "rubric": "Whether the party left the market." },
    { "key": "repaid", "type": "bool", "source": "extractor", "rubric": "Whether the player repaid the trader." },
    { "key": "trader_angry", "type": "bool", "source": "extractor", "rubric": "Whether the trader is still angry." },
    { "key": "ferry_paid", "type": "bool", "source": "extractor", "rubric": "Whether the ferry was paid." },
    { "key": "saw_bell", "type": "bool", "source": "extractor", "rubric": "Whether the party saw the bell rung." },
    { "key": "nerve", "type": "bool", "source": "code", "rubric": "Whether the crossing check succeeded." }
  ],
  "quests": [
    { "id": "fare", "title": "The ferry fare", "kind": "side", "done_when": { "q": "ferry_paid", "op": "==", "v": true }, "steps": [] }
  ],
  "milestones": [
    { "id": "bell", "title": "The bell", "when": { "q": "saw_bell", "op": "==", "v": true } }
  ],
  "checkpoints": [
    { "id": "market", "name": "The market", "player_name": "The market", "type": "anchor", "start": true, "objective": "Trade." },
    { "id": "road", "name": "The road", "player_name": "The road", "type": "anchor", "objective": "Travel.",
      "checks": [{ "id": "steady", "quality": "nerve", "roll": { "sides": 20, "target": 10 }, "narrate": "public" }] }
  ],
  "transitions": [
    { "from": "market", "to": "road", "priority": 1, "gate": { "q": "left_market", "op": "==", "v": true } }
  ],
  "echoes": [
    { "id": "trader", "after": { "transition": "market->road" }, "delay": { "parts": [2, 2] }, "when": { "q": "trader_angry", "op": "==", "v": true },
      "cancel_when": { "q": "repaid", "op": "==", "v": true }, "to": "narrator", "cue": "the trader from the market is in town and remembers the short change" },
    { "id": "fare-thanks", "after": { "quest": "fare", "to": "done" }, "delay": { "boundaries": [2, 2] }, "to": "tom", "cue": "the fare you were paid came just in time" },
    { "id": "bell-talk", "after": { "milestone": "bell" }, "delay": { "boundaries": [1, 3] }, "to": "mara", "cue": "people in the market still talk about the bell", "hold": 3 },
    { "id": "steady-word", "after": { "check": "steady", "outcome": "success" }, "delay": { "boundaries": [1, 1] }, "expires": { "boundaries": 2 }, "to": "mara",
      "cue": "the crossing went smoothly after all" }
  ]
}
