    { "id": "tom", "name": "Tom", "role": "a guild porter", "factions": ["guild"] },
    { "id": "sera", "name": "Sera", "role": "a royal envoy", "factions": ["crown"] },
    { "id": "narrator", "name": "DM Narrator", "role": "narrator", "view": "omniscient" }
  ],
  "factions": [
