        { "id": "paid", "when": { "q": "debt_paid", "op": "==", "v": true }, "add": 1 }
      ]
    },
    {
      "id": "crown", "name": "The Silver Crown", "range": [-3, 3],
      "bands": [{ "max": -1, "label": "Distrusts you" }, { "max": 0, "label": "Watches you" }, { "label": "Favours you" }],
      "visible_when": { "q": "met_crown", "op": "==", "v": true },
      "moves": [{ "id": "envoy", "when": { "q": "envoy_helped", "op": "==", "v": true }, "add": 1 }]
    }
  ],
  "qualities": [
    { "key": "location", "type": "enum", "values": ["hall", "docks", "market"], "source": "extractor", "rubric": "Where the party is", "evidence_from": "party" },
    { "key": "met_guild", "type": "bool", "source": "extractor", "latching": true, "rubric": "Has the player met the guild?" },
    { "key": "met_crown", "type": "bool", "source": "extractor", "latching": true, "rubric": "Has the player met the crown's people?" },
    { "key": "apprentice_saved", "type": "bool", "source": "extractor", "rubric": "Did the player save the apprentice?" },
    { "key": "ledger_stolen", "type": "bool", "source": "extractor", "rubric": "Did the player steal the guild ledger?" },
    { "key": "envoy_helped", "type": "bool", "source": "extractor", "rubric": "Did the player help the envoy?" },
    { "key": "debt_found", "type": "bool", "source": "extractor", "rubric": "Did the player find the debt note?" },
    { "key": "debt_paid", "type": "bool", "source": "code", "rubric": "Set by the reward when the debt quest closes" },
    { "key": "left_hall", "type": "bool", "source": "extractor", "rubric": "Did the party leave the hall?" }
  ],
  "quests": [
    { "id": "debt", "title": "The clerk's debt", "kind": "side", "done_when": { "q": "debt_found", "op": "==", "v": true }, "steps": [],
