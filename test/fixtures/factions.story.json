  ],
  "checkpoints": [
    { "id": "hall", "name": "The guild hall", "objective": "The guild clerk asks for help.", "type": "anchor", "start": true },
    { "id": "street", "name": "The street", "objective": "Rumours follow the party outside.", "type": "anchor" }
  ],
  "transitions": [
    { "from": "hall", "to": "street", "gate": { "q": "left_hall", "op": "==", "v": true }, "priority": 1 }
