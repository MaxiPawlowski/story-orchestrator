{
  "name": "v2.7 39 C6: multi-character image rows on the SOIMG test cast (32 W5 builder, W6 frames, W7 look frames, W8 card overlay per member; rollback of a fired look is v27-card-rollback.json)",
  "requires": {
    "lane": "model",
    "comfy": true,
    "imageHarness": ["editModels", "backgroundRemoval", "rater"],
    "mainApi": "textgenerationwebui",
    "group": "SOIMG Test cast",
    "members": ["SOIMG Wren", "SOIMG Sable", "SOIMG Quill"],
    "authorView": true,
    "why": "plan 32 decision 9: three characters chosen for variety (glasses, hair over the eyes, a non-human face). Seed with art first: st-lanes.mts run <n> -- scripts/debug/so-image-cast.mts seed --art <dir>; LI + CL, x2 consecutive on one lane"
  },
  "steps": [
    { "import_story": { "file": "../fixtures/image-test-cast/cast.story.json" } },
    { "ui": { "action": "briefing-dismiss" } },
    { "ui": { "action": "open-studio" } },
    { "ui": { "action": "studio-tab", "label": "Sprites" } },
    { "ui": { "action": "sprite-reference", "character": "SOIMG Wren", "pack": "" }, "log": true },
    { "ui": { "action": "sprite-reference", "character": "SOIMG Sable", "pack": "" }, "log": true },
    { "ui": { "action": "sprite-reference", "character": "SOIMG Quill", "pack": "" }, "log": true },
    { "ui": { "action": "open-studio" } },
    { "ui": { "action": "studio-tab", "label": "Sprites" } },
    { "ui": { "action": "sprite-base", "character": "SOIMG Wren" }, "log": true },
    { "ui": { "action": "open-studio" } },
    { "ui": { "action": "studio-tab", "label": "Sprites" } },
    { "ui": { "action": "sprite-base", "character": "SOIMG Sable" }, "log": true },
    { "ui": { "action": "open-studio" } },
    { "ui": { "action": "studio-tab", "label": "Sprites" } },
    { "ui": { "action": "sprite-base", "character": "SOIMG Quill" }, "log": true },
    { "ui": { "action": "open-studio" } },
    { "ui": { "action": "studio-tab", "label": "Sprites" } },
    { "ui": { "action": "sprite-frames", "character": "SOIMG Wren", "kinds": ["blink", "talk"], "floor": 0.9 }, "log": true },
    { "ui": { "action": "sprite-frames", "character": "SOIMG Sable", "kinds": ["blink", "talk"], "floor": 0.9 }, "log": true },
    { "ui": { "action": "sprite-frames", "character": "SOIMG Quill", "kinds": ["blink", "talk"], "floor": 0.9 }, "log": true },
    { "ui": { "action": "sprite-frames", "character": "SOIMG Wren", "kinds": [], "looks": ["hair dyed emerald green", "hair dyed silver white", "glasses swapped for red cat-eye frames", "cardigan coloured cobalt blue", "cardigan coloured crimson red"], "floor": 0.9 }, "log": true },
    { "ui": { "action": "sprite-frames", "character": "SOIMG Sable", "kinds": [], "looks": ["fringe dyed bright red", "fringe dyed platinum blonde", "coat coloured forest green", "coat coloured mustard yellow", "silver hoop earring added"], "floor": 0.9 }, "log": true },
    { "ui": { "action": "sprite-frames", "character": "SOIMG Quill", "kinds": [], "looks": ["scales tinted deep blue", "scales tinted ruby red", "horn ridge painted gold", "apron coloured white", "apron coloured purple"], "floor": 0.9 }, "log": true },
    { "ui": { "action": "close-studio" } },
    { "eval": "const rt=globalThis.storyOrchestratorRuntime; await rt.activateCheckpoint('change'); const s=rt.getSnapshot(); const want={wren_hair:'green',sable_coat:'green',quill_apron:'white'}; const off=Object.entries(want).filter(([k,v])=>s.blackboard[k]!==v); if(s.activeCheckpointId!=='change'||off.length) throw Error('card entry writes missing: '+JSON.stringify(off)); return {checkpoint:s.activeCheckpointId, looks:want};" },
    { "ui": { "action": "card-reply-local", "character": "SOIMG Wren", "field": "hair", "value": "green" }, "log": true },
    { "ui": { "action": "card-reply-local", "character": "SOIMG Sable", "field": "coat", "value": "green" }, "log": true },
    { "ui": { "action": "card-reply-local", "character": "SOIMG Quill", "field": "apron", "value": "white" }, "log": true }
  ]
}
