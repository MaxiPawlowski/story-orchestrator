import { test } from 'node:test';
import assert from 'node:assert/strict';
import { readFile, writeFile } from 'node:fs/promises';
import { join } from 'node:path';
import { REPO_ROOT } from './lib/bundleEntry.mts';
import { replayFixture } from './lib/recall.mts';
import { main } from './so-recall.mts';
import { testTempDir } from '../lib/testTemp.mjs';

const FIXTURE = join(process.cwd(), 'test/fixtures/recall/synthetic');
const GOLDEN = join(process.cwd(), 'test/goldens/recall/synthetic-result.json');

const quiet = async <T,>(run: () => Promise<T>): Promise<T> => {
  const log = console.log;
  console.log = () => {};
  try {
    return await run();
  } finally {
    console.log = log;
  }
};

test('recall: the synthetic fixture replays to the golden and passes (exit 0)', async () => {
  const result = await replayFixture(FIXTURE);
  assert.deepEqual(result, JSON.parse(await readFile(GOLDEN, 'utf-8')));
  assert.equal(result.verdict, 'pass');
  assert.match(result.pool, /stub/);
  assert.equal(await quiet(() => main(['replay', '--fixture', FIXTURE])), 0);
});

test('recall: the fixture is regenerated byte-for-byte by its generator', async () => {
  const work = await testTempDir('so-recall-gen-');
  const source = await readFile(join(FIXTURE, 'generate-synthetic.mjs'), 'utf-8');
  await writeFile(join(work, 'generate-synthetic.mjs'), source);
  await import(`file://${join(work, 'generate-synthetic.mjs').replace(/\\/g, '/')}`);
  assert.deepEqual(JSON.parse(await readFile(join(work, 'fixture.json'), 'utf-8')), JSON.parse(await readFile(join(FIXTURE, 'fixture.json'), 'utf-8')));
});

test('recall: a planted witness record that says everyone heard everything fails (exit 1)', async () => {
  const work = await testTempDir('so-recall-planted-');
  const fixture = JSON.parse(await readFile(join(FIXTURE, 'fixture.json'), 'utf-8'));
  for (const session of fixture.sessions) {
    for (const read of session.reads) read.response = read.response.split('\n').filter((line: string) => line.startsWith('WITNESS')).map((line: string) => line.replace(/ (?:heard=.*|mixed)$/, ' heard=all-present')).join('\n');
  }
  await writeFile(join(work, 'fixture.json'), JSON.stringify(fixture));
  const result = await replayFixture(work);
  assert.equal(result.verdict, 'fail');
  assert.equal(await quiet(() => main(['replay', '--fixture', work])), 1);
});

test('recall: below the minimum shape is insufficient (exit 2); private output inside the repo is refused', async () => {
  const work = await testTempDir('so-recall-small-');
  const fixture = JSON.parse(await readFile(join(FIXTURE, 'fixture.json'), 'utf-8'));
  await writeFile(join(work, 'fixture.json'), JSON.stringify({ ...fixture, sessions: fixture.sessions.slice(0, 1) }));
  assert.equal(await quiet(() => main(['replay', '--fixture', work])), 2);
  const privateDir = await testTempDir('so-recall-private-');
  await writeFile(join(privateDir, 'fixture.json'), JSON.stringify({ ...fixture, synthetic: false }));
  await assert.rejects(() => quiet(() => main(['replay', '--fixture', privateDir, '--out', join(REPO_ROOT, 'test/goldens/recall/private.json')])), /private recall output/);
});
