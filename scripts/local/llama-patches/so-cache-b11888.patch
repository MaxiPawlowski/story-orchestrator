From 8f17b1a416f28e24a64f2ac65d7fdfefb36140f1 Mon Sep 17 00:00:00 2001
From: MaxiPawlowski <maxipawlowski@gmail.com>
Date: Mon, 26 Oct 2026 04:52:59 -0300
Subject: [PATCH 02/10] server: keys isolate cache entries both ways, unkeyed
 never evicts keyed, dedup per key, keyed tasks skip foreign slots, validate
 state write length

---
 tools/server/server-context.cpp | 16 +++++++++++++---
 tools/server/server-task.cpp    | 24 +++++++++++++++++++++---
 2 files changed, 34 insertions(+), 6 deletions(-)

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 7393ff2..e51ebbc 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -361,9 +361,14 @@ struct server_slot {
             return false;
         }
 
-        llama_state_seq_get_data_ext(ctx_tgt, cur->data.main.data(), cur_size_tgt, id, LLAMA_STATE_SEQ_FLAGS_NONE);
-        if (ctx_dft) {
-            llama_state_seq_get_data_ext(ctx_dft, cur->data.drft.data(), cur_size_dft, id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        const size_t n_tgt = llama_state_seq_get_data_ext(ctx_tgt, cur->data.main.data(), cur_size_tgt, id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        const size_t n_dft = ctx_dft ? llama_state_seq_get_data_ext(ctx_dft, cur->data.drft.data(), cur_size_dft, id, LLAMA_STATE_SEQ_FLAGS_NONE) : 0;
+
+        // the buffers are not zero-filled: keep the entry only when every byte was written
+        if (n_tgt != cur_size_tgt || n_dft != cur_size_dft) {
+            SRV_WRN(" - prompt state write incomplete (%zu of %zu, draft %zu of %zu), dropping the entry\n", n_tgt, cur_size_tgt, n_dft, cur_size_dft);
+            prompt_cache.states.pop_back();
+            return false;
         }
 
         return true;
@@ -1809,6 +1814,11 @@ private:
 
                 const auto & tokens = slot.prompt.tokens;
 
+                // a keyed task only reuses a slot holding its own key's state
+                if (!task.params.cache_key.empty() && slot.cache_key != task.params.cache_key) {
+                    continue;
+                }
+
                 // skip the slot if it does not contains cached tokens
                 if (tokens.empty()) {
                     SLT_TRC(slot, "%s", " - skipping, slot is empty\n");
diff --git a/tools/server/server-task.cpp b/tools/server/server-task.cpp
index dd83b39..c0f89b1 100644
