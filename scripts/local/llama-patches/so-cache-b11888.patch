+llama_decode_profile llama_context::decode_profile_take() {
+    llama_decode_profile res = {
+        /*.n_decode     =*/ prof.n_decode,
+        /*.n_outputs    =*/ prof.n_outputs,
+        /*.t_compute_ms =*/ prof.t_compute_us / 1000.0,
+        /*.t_logits_ms  =*/ prof.t_logits_us / 1000.0,
+        /*.logits_mib   =*/ prof.logits_bytes / (1024.0 * 1024.0),
+    };
+    prof = {};
