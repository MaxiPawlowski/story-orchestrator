+struct llama_decode_profile {
+    int64_t n_decode;     // ubatches computed
+    int64_t n_outputs;    // logit rows copied to the host
+    double  t_compute_ms; // wait for the graph after submission
+    double  t_logits_ms;  // logit copy to the host, synchronized
