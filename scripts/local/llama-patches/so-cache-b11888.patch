+        }
+        if (timing && !rinfos.empty()) {
+            LLAMA_LOG_INFO("state timing: restore %zu regions (%zu under 64 KiB), %.3f MiB, tensor_set %.2f ms (max region %.3f ms), parse+memcpy before it %.2f ms\n",
+                    rinfos.size(), small, bytes / (1024.0 * 1024.0), (ggml_time_us() - t0) / 1000.0, t_max / 1000.0, (t0 - t_created) / 1000.0);
         }
     }
 
@@ -3025,6 +3080,7 @@ private:
         size_t offset;
     };
     std::vector<read_info> rinfos;
+    int64_t t_created = 0;
 };
 
