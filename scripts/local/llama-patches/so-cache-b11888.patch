         }
 
@@ -2924,9 +2951,22 @@ public:
             uint8_t * p, size_t len) : ptr(p), buf_size(len) {}
 
     ~llama_io_write_host() {
+        static const bool timing = getenv("LLAMA_STATE_TIMING") != nullptr;
