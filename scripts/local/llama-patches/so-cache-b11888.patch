+        if (timing && !winfos.empty()) {
+            LLAMA_LOG_INFO("state timing: save %zu regions, %.3f MiB, tensor_get %.2f ms (max region %.3f ms)\n",
+                    winfos.size(), bytes / (1024.0 * 1024.0), (ggml_time_us() - t0) / 1000.0, t_max / 1000.0);
         }
     }
 
@@ -2973,12 +3013,27 @@ private:
 
