+// keyed prompt cache entries spilled to files (POST /cache/spill), loaded back when their key returns
+// files live in <root>/<pid>: hashed names, written to a temp name then renamed, integrity hash and a fingerprint of
+// the model, context/KV configuration and file format; a mismatch or a corrupt file is a cold miss; every file is
+// deleted when it is loaded, when the cache is cleared and when the server exits
+struct server_cache_spill_entry {
+    std::filesystem::path path;
+    std::string  key;
+    llama_tokens tokens;
+    size_t       bytes = 0;
+};
