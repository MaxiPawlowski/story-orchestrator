+#if defined(_WIN32)
+// unbuffered overlapped reads with several requests in flight: the buffered path issues one synchronous read at a time,
+// which an NVMe drive serves far below its sequential rate when the file is not in the page cache
+struct llama_overlapped_reader {
+    HANDLE handle = INVALID_HANDLE_VALUE;
+    std::vector<OVERLAPPED> ovl;
+    std::vector<HANDLE> events;
+    std::vector<DWORD> requested;
+
+    bool open(const std::string & path, size_t depth) {
+        if (path.empty()) {
+            return false;
+        }
+        std::wstring wpath(path.size(), L'\0');
+        const int n = MultiByteToWideChar(CP_UTF8, 0, path.c_str(), (int) path.size(), wpath.data(), (int) wpath.size());
+        if (n <= 0) {
+            return false;
+        }
+        wpath.resize(n);
+        handle = CreateFileW(wpath.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING,
+            FILE_FLAG_NO_BUFFERING | FILE_FLAG_OVERLAPPED | FILE_FLAG_SEQUENTIAL_SCAN, nullptr);
+        if (handle == INVALID_HANDLE_VALUE) {
+            return false;
+        }
+        ovl.assign(depth, OVERLAPPED{});
+        requested.assign(depth, 0);
+        for (size_t i = 0; i < depth; ++i) {
+            events.push_back(CreateEventW(nullptr, TRUE, FALSE, nullptr));
+            if (!events.back()) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    void issue(size_t slot, void * dst, size_t offset, DWORD len) {
+        OVERLAPPED & o = ovl[slot];
+        o = OVERLAPPED{};
+        o.Offset     = (DWORD) (offset & 0xffffffffull);
+        o.OffsetHigh = (DWORD) (offset >> 32);
+        o.hEvent     = events[slot];
+        ResetEvent(events[slot]);
+        requested[slot] = len;
+        if (!ReadFile(handle, dst, len, nullptr, &o) && GetLastError() != ERROR_IO_PENDING) {
+            throw std::runtime_error(format("overlapped read failed at offset %zu: error %lu", offset, GetLastError()));
+        }
+    }
+
+    size_t wait(size_t slot) {
+        DWORD got = 0;
+        if (!GetOverlappedResult(handle, &ovl[slot], &got, TRUE)) {
+            const DWORD err = GetLastError();
+            if (err != ERROR_HANDLE_EOF) {
+                throw std::runtime_error(format("overlapped read failed: error %lu", err));
+            }
+        }
+        return got;
+    }
+
+    ~llama_overlapped_reader() {
+        for (HANDLE e : events) {
+            if (e) {
+                CloseHandle(e);
+            }
+        }
+        if (handle != INVALID_HANDLE_VALUE) {
+            CancelIoEx(handle, nullptr);
+            CloseHandle(handle);
+        }
+    }
+};
+#endif
