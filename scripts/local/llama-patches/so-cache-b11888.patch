From 603203f774353a2bafab7c2e7f3df20c189e6420 Mon Sep 17 00:00:00 2001
From: MaxiPawlowski <maxipawlowski@gmail.com>
Date: Mon, 26 Oct 2026 07:52:05 -0300
Subject: [PATCH 3/6] server: checkpoint_at request positions, cache_rewind
 saves the state rewound to the cut checkpoint

---
 tools/server/server-context.cpp | 58 +++++++++++++++++++++++++++++++--
 tools/server/server-schema.cpp  | 18 ++++++++++
 tools/server/server-task.h      |  2 ++
 3 files changed, 75 insertions(+), 3 deletions(-)

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index e51ebbc..5cb53e5 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -342,8 +342,50 @@ struct server_slot {
     // prompt cache options of the task that produced the current prompt state
     std::string cache_key;
     int32_t     cache_ckpt_max = -1;
+    bool        cache_rewind   = false;
+
+    void prompt_rewind_to_cut() {
+        if (!cache_rewind || cache_ckpt_max <= 0) {
+            return;
+        }
+
+        int64_t n_keep = -1;
+        auto    it_cut = prompt.checkpoints.end();
+        for (auto it = prompt.checkpoints.begin(); it != prompt.checkpoints.end(); ++it) {
+            if (it->n_tokens > 0 && it->n_tokens <= cache_ckpt_max && it->n_tokens > n_keep) {
+                n_keep = it->n_tokens;
+                it_cut = it;
+            }
+        }
+
+        if (it_cut == prompt.checkpoints.end() || n_keep >= (int64_t) prompt.tokens.size()) {
+            return;
+        }
+
+        const auto & cut = *it_cut;
+        if (!cut.load_tgt(ctx_tgt, id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) || !cut.load_dft(ctx_dft, id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY)) {
+            SLT_WRN(*this, "could not rewind to the context checkpoint at %" PRId64 " tokens, dropping the state\n", n_keep);
+            prompt_clear();
+            return;
+        }
+
+        prompt.tokens.keep_first(n_keep);
+        mem.seq_rm(id, prompt.tokens.pos_next(), -1);
+
+        for (auto it = prompt.checkpoints.begin(); it != prompt.checkpoints.end();) {
+            if (it->n_tokens > n_keep) {
+                it = prompt.checkpoints.erase(it);
+            } else {
+                ++it;
+            }
+        }
+
+        SLT_INF(*this, "rewound the cached state to the checkpoint at %" PRId64 " tokens\n", n_keep);
+    }
+
+    bool prompt_save(server_prompt_cache & prompt_cache) {
+        prompt_rewind_to_cut();
 
-    bool prompt_save(server_prompt_cache & prompt_cache) const {
         if (prompt.tokens.size() == 0) {
             return false;
         }
@@ -2070,6 +2112,7 @@ private:
 
         slot.cache_key      = task.params.cache_key;
         slot.cache_ckpt_max = task.params.cache_ckpt_max;
+        slot.cache_rewind   = task.params.cache_rewind;
 
         slot.task = std::make_unique<const server_task>(std::move(task));
 
@@ -4364,6 +4407,10 @@ private:
 
                     const auto & spans = slot.task->params.message_spans;
                     const auto last_user_pos = spans.last_user_message_pos();
+                    const auto & checkpoint_at = slot.task->params.checkpoint_at;
+                    const auto is_requested = [&](int64_t pos) {
+                        return std::find(checkpoint_at.begin(), checkpoint_at.end(), (int32_t) pos) != checkpoint_at.end();
+                    };
 
                     const int32_t n_decision_first = slot.task->type == SERVER_TASK_TYPE_DECISION ? slot.task->decision.pos_first() : -1;
 
@@ -4407,6 +4454,10 @@ private:
                         slot.prompt.tokens.push_back(cur_tok);
 
                         // break at the last user message, or at user messages at least min step past the last checkpoint
+                        if (do_checkpoint && is_requested(slot.prompt.n_tokens())) {
+                            break;
+                        }
+
                         if (do_checkpoint && spans.is_user_start(slot.prompt.n_tokens())) {
                             const auto pos = slot.prompt.n_tokens();
                             const auto & checkpoints = slot.prompt.checkpoints;
@@ -4445,8 +4496,9 @@ private:
 
                     const bool near_prompt_end = slot.task->n_tokens() < slot.prompt.n_tokens() + n_ubatch;
 
-                    const bool is_user_start = spans.is_user_start(n_tokens_start);
-                    const bool is_last_user_message = n_tokens_start == last_user_pos;
+                    const bool is_requested_start = is_requested(n_tokens_start);
+                    const bool is_user_start = spans.is_user_start(n_tokens_start) || is_requested_start;
+                    const bool is_last_user_message = n_tokens_start == last_user_pos || is_requested_start;
 
                     // entire prompt has been processed
                     if (slot.prompt.n_tokens() == slot.task->n_tokens()) {
diff --git a/tools/server/server-schema.cpp b/tools/server/server-schema.cpp
index 0e14d1e..0aae760 100644
--- a/tools/server/server-schema.cpp
+++ b/tools/server/server-schema.cpp
@@ -43,6 +43,24 @@ std::vector<std::unique_ptr<field>> make_llama_cmpl_schema(const common_params &
         ->set_hard_limits(-1, INT32_MAX)
         ->set_desc("When this request's state is saved to the prompt cache, keep only the newest context checkpoint at or before this many tokens (-1 keeps all)"));
 
+    add((new field_bool("cache_rewind", params.cache_rewind))
+        ->set_desc("With cache_ckpt_max: rewind the cached state to that checkpoint, so the entry holds only the prompt up to it"));
+
+    add((new field_json("checkpoint_at"))
+        ->set_desc("Prompt positions in tokens where a context checkpoint is created while the prompt is processed")
+        ->set_handler([&](field_eval_context & ctx, const json & data) {
+            const auto positions = data.at("checkpoint_at").get<std::vector<int32_t>>();
+            if (positions.size() > 8) {
+                throw std::invalid_argument("checkpoint_at holds at most 8 positions");
+            }
+            for (const auto pos : positions) {
+                if (pos <= 0) {
+                    throw std::invalid_argument("checkpoint_at positions must be positive");
+                }
+            }
+            ctx.params.checkpoint_at = positions;
+        }));
+
     add((new field_bool("return_tokens", params.return_tokens))
         ->set_desc("Return the raw generated token ids in the `tokens` field"));
 
diff --git a/tools/server/server-task.h b/tools/server/server-task.h
index 9b679b3..e65b094 100644
--- a/tools/server/server-task.h
+++ b/tools/server/server-task.h
@@ -66,6 +66,8 @@ struct task_params {
 
     std::string cache_key;          // prompt cache: entries saved from this request's state carry the key; a keyed request loads only entries with its key
     int32_t     cache_ckpt_max = -1; // prompt cache: keep only the newest context checkpoint at or before this many tokens when the state is cached (-1 = all)
+    bool        cache_rewind   = false; // prompt cache: rewind the saved state to that checkpoint, dropping every token after it
+    std::vector<int32_t> checkpoint_at; // prompt positions (in tokens) where a context checkpoint is created during prompt processing
     bool return_tokens   = false;
     bool return_progress = false;
 
