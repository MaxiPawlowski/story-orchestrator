+server_cache_spill::~server_cache_spill() {
+    clear();
+    if (!dir.empty()) {
+        std::error_code ec;
+        std::filesystem::remove_all(dir, ec);
+    }
+}
+
+bool server_cache_spill::init(const std::string & root, int32_t max_mib) {
+    std::error_code ec;
+    if (root.empty() || !std::filesystem::is_directory(root, ec)) {
+        SRV_WRN("cache spill off: directory '%s' does not exist (the caller creates it with owner-only access)\n", root.c_str());
+        return false;
+    }
+    dir = std::filesystem::path(root) / std::to_string((long long) SERVER_SPILL_PID());
+    std::filesystem::create_directory(dir, ec);
+    if (!std::filesystem::is_directory(dir, ec)) {
+        SRV_WRN("cache spill off: could not create '%s'\n", dir.string().c_str());
+        dir.clear();
+        return false;
+    }
+#ifndef _WIN32
+    std::filesystem::permissions(dir, std::filesystem::perms::owner_all, std::filesystem::perm_options::replace, ec);
+#endif
+    for (const auto & item : std::filesystem::directory_iterator(dir, ec)) {
+        std::error_code ec_rm;
+        std::filesystem::remove(item.path(), ec_rm);
+    }
+    max_bytes = 1024ull*1024ull*(size_t) std::max<int32_t>(0, max_mib);
+    SRV_INF("cache spill on: %s, bound %d MiB\n", dir.string().c_str(), max_mib);
+    return true;
+}
+
+size_t server_cache_spill::bytes() const {
+    size_t res = 0;
+    for (const auto & entry : entries) {
+        res += entry.bytes;
+    }
+    return res;
+}
+
+void server_cache_spill::remove(std::list<server_cache_spill_entry>::iterator it) {
+    std::error_code ec;
+    std::filesystem::remove(it->path, ec);
+    entries.erase(it);
+}
+
+void server_cache_spill::clear() {
+    while (!entries.empty()) {
+        remove(entries.begin());
+    }
+    if (!dir.empty()) {
+        std::error_code ec;
+        for (const auto & item : std::filesystem::directory_iterator(dir, ec)) {
+            std::error_code ec_rm;
+            std::filesystem::remove(item.path(), ec_rm);
+        }
+    }
+}
+
+void server_cache_spill::set_fingerprint(uint64_t fp) {
+    if (fingerprint != 0 && fingerprint != fp && !entries.empty()) {
+        SRV_WRN("cache spill: fingerprint changed, deleting %zu spilled entries\n", entries.size());
+        clear();
+    }
+    fingerprint = fp;
+}
+
+void server_cache_spill::drop_contained(const std::string & key, const server_tokens & tokens) {
+    if (tokens.has_mtmd) {
+        return;
+    }
+    const auto & cur = tokens.get_tokens();
+    for (auto it = entries.begin(); it != entries.end();) {
+        if (it->key == key && spill_common_prefix(it->tokens, cur) == it->tokens.size()) {
+            auto next = std::next(it);
+            remove(it);
+            it = next;
+        } else {
+            ++it;
+        }
+    }
+}
+
+bool server_cache_spill::write(server_prompt_cache_state & state) {
+    if (dir.empty()) {
+        return false;
+    }
+    if (state.prompt.tokens.has_mtmd) {
+        n_dropped++;
+        return false;
+    }
+    const auto & toks = state.prompt.tokens.get_tokens();
+    if (toks.empty() || std::find(toks.begin(), toks.end(), LLAMA_TOKEN_NULL) != toks.end()) {
+        n_dropped++;
+        return false;
+    }
+    const size_t need = state.size() + toks.size()*sizeof(llama_token) + 4096;
+    if (need > max_bytes) {
+        n_dropped++;
+        return false;
+    }
+    while (!entries.empty() && bytes() + need > max_bytes) {
+        SRV_WRN("cache spill: size bound reached, deleting the oldest spilled entry (%.3f MiB)\n", entries.front().bytes / (1024.0 * 1024.0));
+        remove(entries.begin());
+    }
+    std::error_code ec;
+    std::filesystem::create_directory(dir, ec);
+    const auto space = std::filesystem::space(dir, ec);
+    if (ec || space.available < need + SERVER_SPILL_DISK_KEEP) {
+        SRV_WRN("%s", "cache spill: not enough free disk space, entry dropped\n");
+        n_dropped++;
+        return false;
+    }
+
+    const int64_t t0 = ggml_time_us();
+    const uint64_t name_hash = server_spill_hash(state.key.data(), state.key.size(), fingerprint ^ (++seq * SERVER_SPILL_P1) ^ (uint64_t) t0);
+    char name[24];
+    snprintf(name, sizeof(name), "%016llx", (unsigned long long) name_hash);
+    const auto path_final = dir / (std::string(name) + ".spill");
+    const auto path_tmp   = dir / (std::string(name) + ".tmp");
+
+    bool ok = false;
+    size_t written = 0;
+    {
+        std::ofstream f(path_tmp, std::ios::binary | std::ios::trunc);
+        if (f) {
+            spill_writer w { f };
+            w.put(SERVER_SPILL_MAGIC, sizeof(SERVER_SPILL_MAGIC));
+            w.put_pod(SERVER_SPILL_VERSION);
+            w.put_pod(fingerprint);
+            w.put_vec(state.key);
+            const uint64_t n_tok = toks.size();
+            w.put_pod(n_tok);
+            w.put(toks.data(), (size_t) n_tok*sizeof(llama_token));
+            const uint32_t n_ckpt = (uint32_t) state.prompt.checkpoints.size();
+            w.put_pod(n_ckpt);
+            for (const auto & ckpt : state.prompt.checkpoints) {
+                w.put_pod(ckpt.n_tokens);
+                w.put_pod(ckpt.id_task);
+                w.put_pod(ckpt.pos_min);
+                w.put_pod(ckpt.pos_max);
+                w.put_vec(ckpt.data_tgt);
+                w.put_vec(ckpt.data_dft);
+                w.put_vec(ckpt.data_spec);
+            }
+            w.put_vec(state.data.main);
+            w.put_vec(state.data.drft);
+            const uint64_t hash = w.hash;
+            f.write((const char *) &hash, sizeof(hash));
+            f.flush();
+            ok = (bool) f;
+            written = ok ? (size_t) f.tellp() : 0;
+        }
+    }
+    if (ok) {
+        std::filesystem::rename(path_tmp, path_final, ec);
+        ok = !ec;
+    }
+    if (!ok) {
+        std::filesystem::remove(path_tmp, ec);
+        SRV_WRN("%s", "cache spill: write failed, entry dropped\n");
+        n_dropped++;
+        return false;
+    }
+
+    entries.push_back({ path_final, state.key, toks, written });
+    n_writes++;
+    SRV_INF("cache spill: wrote %d tokens, %.3f MiB in %.1f ms\n", (int) toks.size(), written / (1024.0 * 1024.0), (ggml_time_us() - t0) / 1000.0);
+    return true;
+}
+
+bool server_cache_spill::read(std::list<server_cache_spill_entry>::iterator it, server_prompt_cache_state & out) {
+    const auto path = it->path;
+    const auto key  = it->key;
+    entries.erase(it);
+
+    const int64_t t0 = ggml_time_us();
+    bool ok = false;
+    std::error_code ec;
+    const uint64_t size = std::filesystem::file_size(path, ec);
+    if (!ec && size > sizeof(uint64_t)) {
+        std::ifstream f(path, std::ios::binary);
+        if (f) {
+            spill_reader r { f, size - sizeof(uint64_t) };
+            char magic[sizeof(SERVER_SPILL_MAGIC)];
+            uint32_t version = 0;
+            uint64_t fp = 0;
+            std::string file_key;
+            ok = r.get(magic, sizeof(magic)) && memcmp(magic, SERVER_SPILL_MAGIC, sizeof(magic)) == 0
+                && r.get_pod(version) && version == SERVER_SPILL_VERSION
+                && r.get_pod(fp) && fp == fingerprint
+                && r.get_vec(file_key) && file_key == key;
+            llama_tokens toks;
+            uint64_t n_tok = 0;
+            ok = ok && r.get_pod(n_tok) && n_tok > 0 && n_tok*sizeof(llama_token) <= r.remaining;
+            if (ok) {
+                toks.resize((size_t) n_tok);
+                ok = r.get(toks.data(), n_tok*sizeof(llama_token));
+            }
+            uint32_t n_ckpt = 0;
+            ok = ok && r.get_pod(n_ckpt) && n_ckpt <= 1024;
+            std::list<common_prompt_checkpoint> checkpoints;
+            for (uint32_t i = 0; ok && i < n_ckpt; ++i) {
+                common_prompt_checkpoint ckpt;
+                ok = r.get_pod(ckpt.n_tokens) && r.get_pod(ckpt.id_task) && r.get_pod(ckpt.pos_min) && r.get_pod(ckpt.pos_max)
+                    && r.get_vec(ckpt.data_tgt) && r.get_vec(ckpt.data_dft) && r.get_vec(ckpt.data_spec);
+                if (ok) {
+                    checkpoints.push_back(std::move(ckpt));
+                }
+            }
+            server_state_buffer main;
+            server_state_buffer drft;
+            ok = ok && r.get_vec(main) && r.get_vec(drft) && r.remaining == 0;
+            uint64_t stored = 0;
+            if (ok) {
+                f.read((char *) &stored, sizeof(stored));
+                ok = (bool) f && stored == r.hash;
+            }
+            if (ok) {
+                out.prompt.tokens      = server_tokens(toks, false);
+                out.prompt.checkpoints = std::move(checkpoints);
+                out.data.main          = std::move(main);
+                out.data.drft          = std::move(drft);
+                out.key                = key;
+            }
+        }
+    }
+    std::filesystem::remove(path, ec);
+
+    if (ok) {
+        n_reads++;
+        SRV_INF("cache spill: read %d tokens, %.3f MiB in %.1f ms\n", out.prompt.n_tokens(), size / (1024.0 * 1024.0), (ggml_time_us() - t0) / 1000.0);
+    } else {
+        n_misses++;
+        SRV_WRN("%s", "cache spill: spilled entry unreadable, corrupt or foreign: cold miss, file deleted\n");
+    }
+    return ok;
+}
