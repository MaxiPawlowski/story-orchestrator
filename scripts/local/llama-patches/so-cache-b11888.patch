+//
+// server_cache_spill
+//
+
+static constexpr char     SERVER_SPILL_MAGIC[8]  = { 'S', 'O', 'S', 'P', 'I', 'L', 'L', '\0' };
+static constexpr uint32_t SERVER_SPILL_VERSION   = 1;
+static constexpr uint64_t SERVER_SPILL_P1        = 0x9E3779B185EBCA87ULL;
+static constexpr uint64_t SERVER_SPILL_P2        = 0xC2B2AE3D27D4EB4FULL;
+static constexpr size_t   SERVER_SPILL_DISK_KEEP = 2ull*1024ull*1024ull*1024ull;
+
+static inline uint64_t server_spill_rotl(uint64_t x, int r) {
+    return (x << r) | (x >> (64 - r));
+}
+
+uint64_t server_spill_hash(const void * data, size_t len, uint64_t seed) {
+    const uint8_t * p = (const uint8_t *) data;
+    uint64_t v[4] = { seed + SERVER_SPILL_P1 + SERVER_SPILL_P2, seed + SERVER_SPILL_P2, seed, seed - SERVER_SPILL_P1 };
+    size_t i = 0;
+    for (; i + 32 <= len; i += 32) {
+        for (int l = 0; l < 4; ++l) {
+            uint64_t w;
+            memcpy(&w, p + i + 8*l, 8);
+            v[l] = server_spill_rotl(v[l] + w*SERVER_SPILL_P2, 31) * SERVER_SPILL_P1;
+        }
+    }
+    uint64_t h = server_spill_rotl(v[0], 1) + server_spill_rotl(v[1], 7) + server_spill_rotl(v[2], 12) + server_spill_rotl(v[3], 18) + (uint64_t) len;
+    for (; i + 8 <= len; i += 8) {
+        uint64_t w;
+        memcpy(&w, p + i, 8);
+        h = server_spill_rotl(h ^ (w*SERVER_SPILL_P2), 27) * SERVER_SPILL_P1;
+    }
+    for (; i < len; ++i) {
+        h = server_spill_rotl(h ^ (p[i]*SERVER_SPILL_P1), 11) * SERVER_SPILL_P2;
+    }
+    h ^= h >> 33; h *= SERVER_SPILL_P2;
+    h ^= h >> 29; h *= SERVER_SPILL_P1;
+    h ^= h >> 32;
+    return h;
+}
+
+namespace {
+
+struct spill_writer {
+    std::ofstream & f;
+    uint64_t hash = 0;
+
+    void put(const void * data, size_t len) {
+        hash = server_spill_hash(data, len, hash);
+        f.write((const char *) data, (std::streamsize) len);
+    }
+    template <typename T> void put_pod(const T & value) {
+        put(&value, sizeof(T));
+    }
+    template <typename V> void put_vec(const V & vec) {
+        const uint64_t n = vec.size();
+        put_pod(n);
+        if (n > 0) {
+            put(vec.data(), (size_t) n);
+        }
+    }
+};
+
+struct spill_reader {
+    std::ifstream & f;
+    uint64_t remaining;
+    uint64_t hash = 0;
+    bool ok = true;
+
+    bool get(void * data, uint64_t len) {
+        if (!ok || len > remaining) {
+            ok = false;
+            return false;
+        }
+        f.read((char *) data, (std::streamsize) len);
+        if (!f) {
+            ok = false;
+            return false;
+        }
+        remaining -= len;
+        hash = server_spill_hash(data, (size_t) len, hash);
+        return true;
+    }
+    template <typename T> bool get_pod(T & value) {
+        return get(&value, sizeof(T));
+    }
+    template <typename V> bool get_vec(V & vec) {
+        uint64_t n = 0;
+        if (!get_pod(n) || n > remaining) {
+            ok = false;
+            return false;
+        }
+        vec.resize((size_t) n);
+        return n == 0 || get(vec.data(), n);
+    }
+};
+
+size_t spill_common_prefix(const llama_tokens & a, const llama_tokens & b) {
+    const size_t n = std::min(a.size(), b.size());
+    size_t i = 0;
+    while (i < n && a[i] == b[i] && a[i] != LLAMA_TOKEN_NULL) {
+        ++i;
+    }
+    return i;
+}
+
+}
