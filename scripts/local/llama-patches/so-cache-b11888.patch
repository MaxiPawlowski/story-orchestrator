From 8f17b1a416f28e24a64f2ac65d7fdfefb36140f1 Mon Sep 17 00:00:00 2001
From: MaxiPawlowski <maxipawlowski@gmail.com>
Date: Mon, 26 Oct 2026 04:52:59 -0300
Subject: [PATCH 2/2] server: keys isolate cache entries both ways, unkeyed
 never evicts keyed, dedup per key, keyed tasks skip foreign slots, validate
 state write length

---
 tools/server/server-context.cpp | 16 +++++++++++++---
 tools/server/server-task.cpp    | 24 +++++++++++++++++++++---
 2 files changed, 34 insertions(+), 6 deletions(-)

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 7393ff2..e51ebbc 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -361,9 +361,14 @@ struct server_slot {
             return false;
         }
 
-        llama_state_seq_get_data_ext(ctx_tgt, cur->data.main.data(), cur_size_tgt, id, LLAMA_STATE_SEQ_FLAGS_NONE);
-        if (ctx_dft) {
-            llama_state_seq_get_data_ext(ctx_dft, cur->data.drft.data(), cur_size_dft, id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        const size_t n_tgt = llama_state_seq_get_data_ext(ctx_tgt, cur->data.main.data(), cur_size_tgt, id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        const size_t n_dft = ctx_dft ? llama_state_seq_get_data_ext(ctx_dft, cur->data.drft.data(), cur_size_dft, id, LLAMA_STATE_SEQ_FLAGS_NONE) : 0;
+
+        // the buffers are not zero-filled: keep the entry only when every byte was written
+        if (n_tgt != cur_size_tgt || n_dft != cur_size_dft) {
+            SRV_WRN(" - prompt state write incomplete (%zu of %zu, draft %zu of %zu), dropping the entry\n", n_tgt, cur_size_tgt, n_dft, cur_size_dft);
+            prompt_cache.states.pop_back();
+            return false;
         }
 
         return true;
@@ -1809,6 +1814,11 @@ private:
 
                 const auto & tokens = slot.prompt.tokens;
 
+                // a keyed task only reuses a slot holding its own key's state
+                if (!task.params.cache_key.empty() && slot.cache_key != task.params.cache_key) {
+                    continue;
+                }
+
                 // skip the slot if it does not contains cached tokens
                 if (tokens.empty()) {
                     SLT_TRC(slot, "%s", " - skipping, slot is empty\n");
diff --git a/tools/server/server-task.cpp b/tools/server/server-task.cpp
index dd83b39..c0f89b1 100644
--- a/tools/server/server-task.cpp
+++ b/tools/server/server-task.cpp
@@ -1756,6 +1756,10 @@ void server_prompt_cache::pop_oldest() {
 server_prompt_cache_state * server_prompt_cache::alloc(const server_prompt & prompt, size_t state_size_tgt, size_t state_size_dft, const std::string & key, int32_t ckpt_max) {
     // first check if the current state is contained fully in the cache
     for (auto it = states.begin(); it != states.end(); ++it) {
+        if (it->key != key) {
+            continue;
+        }
+
         const int cur_lcp_len = it->prompt.tokens.get_common_prefix(prompt.tokens);
 
         if (cur_lcp_len == (int) prompt.tokens.size()) {
@@ -1795,7 +1799,7 @@ server_prompt_cache_state * server_prompt_cache::alloc(const server_prompt & pro
 
     // remove any cached prompts that are fully contained in the current prompt
     for (auto it = states.begin(); it != states.end();) {
-        const int len = it->prompt.tokens.get_common_prefix(prompt.tokens);
+        const int len = it->key == key ? it->prompt.tokens.get_common_prefix(prompt.tokens) : -1;
 
         if (len == (int) it->prompt.tokens.size()) {
             SRV_TRC(" - removing obsolete cached prompt with length %d\n", len);
@@ -1807,6 +1811,20 @@ server_prompt_cache_state * server_prompt_cache::alloc(const server_prompt & pro
     }
 
     if (limit_size > 0) {
+        // an unkeyed state never pushes out a keyed one
+        if (key.empty()) {
+            size_t unkeyed = 0;
+            for (const auto & state : states) {
+                if (state.key.empty()) {
+                    unkeyed += state.size();
+                }
+            }
+            if (size() - unkeyed + state_size_new > limit_size) {
+                SRV_WRN(" - unkeyed prompt state %.3f MiB would evict keyed entries, skipping\n", state_size_new / (1024.0 * 1024.0));
+                return nullptr;
+            }
+        }
+
         // make room before allocating the new vectors to avoid breaching the limit
         while (!states.empty() && size() + state_size_new > limit_size) {
             SRV_WRN(" - making room for prompt cache entry, removing oldest entry (size = %.3f MiB)\n",
@@ -1874,8 +1892,8 @@ bool server_prompt_cache::load(server_prompt & prompt, const server_tokens & tok
             continue;
         }
 
-        // a keyed request only takes entries with its own key
-        if (!key.empty() && it->key != key) {
+        // entries are only restored by requests with the same key (unkeyed by unkeyed)
+        if (it->key != key) {
             continue;
         }
 
