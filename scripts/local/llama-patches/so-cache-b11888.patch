+server_prompt_cache_spill_result server_prompt_cache::spill_down_to(size_t keep_bytes) {
+    server_prompt_cache_spill_result res;
+    const int64_t t0 = ggml_time_us();
+    while (!states.empty() && size() > keep_bytes) {
+        auto it = states.begin();
+        for (auto jt = states.begin(); jt != states.end(); ++jt) {
+            if (jt->key.empty()) {
+                it = jt;
+                break;
+            }
+        }
+        const size_t sz = it->size();
+        if (!it->key.empty() && spill && spill->write(*it)) {
+            res.n_spilled++;
+            res.bytes += sz;
+        } else {
+            res.n_dropped++;
+        }
+        states.erase(it);
+    }
+    res.t_ms = (ggml_time_us() - t0) / 1000.0;
+    return res;
+}
